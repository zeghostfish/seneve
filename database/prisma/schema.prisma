generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IdentityStatus {
  PENDING_EMAIL_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CredentialType {
  PASSWORD
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TrustedDeviceStatus {
  TRUSTED
  REVOKED
}

enum RefreshTokenStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
}

enum OneTimeTokenStatus {
  PENDING
  CONSUMED
  REVOKED
  EXPIRED
}

enum IdentitySecurityEventType {
  IDENTITY_REGISTERED
  EMAIL_VERIFICATION_REQUESTED
  EMAIL_VERIFICATION_RESENT
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_FAILED
  EMAIL_VERIFICATION_EXPIRED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_RESENT
  PASSWORD_RESET_COMPLETED
  PASSWORD_RESET_FAILED
  PASSWORD_RESET_EXPIRED
  PASSWORD_CREDENTIAL_REPLACED
  SESSIONS_REVOKED_AFTER_PASSWORD_RESET
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  SESSION_CREATED
  SESSION_REVOKED
  REFRESH_TOKEN_ROTATED
  REFRESH_TOKEN_REUSE_DETECTED
  IDENTITY_SUSPENDED
  SESSION_EXPIRED
  NEW_DEVICE
  SUSPICIOUS_LOGIN
  CONCURRENT_LOGIN_LIMIT_REACHED
  ADMINISTRATOR_SESSION_REVOKED
  SECURITY_POLICY_VIOLATION
}

enum OrganizationStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  CLOSED
  ARCHIVED
}

enum OrganizationMembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum OrganizationRole {
  OWNER
  ADMINISTRATOR
  EVENT_MANAGER
  FINANCE_MANAGER
  CONTENT_MANAGER
  VIEWER
  AUDITOR
}

enum OrganizationInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum CampaignVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum CampaignVotingMode {
  FREE
  PAID
  HYBRID
}

enum CampaignResultsVisibility {
  HIDDEN
  LIVE
  AFTER_CAMPAIGN
  SCHEDULED
}

enum CandidateStatus {
  DRAFT
  ELIGIBLE
  SUSPENDED
  WITHDRAWN
  DISQUALIFIED
  ARCHIVED
}

model Identity {
  id                          String                   @id @default(uuid()) @db.Uuid
  status                      IdentityStatus
  normalizedLoginEmail        String                   @map("normalized_login_email")
  version                     Int                      @default(1)
  createdAt                   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  suspendedAt                 DateTime?                @map("suspended_at") @db.Timestamptz(6)
  closedAt                    DateTime?                @map("closed_at") @db.Timestamptz(6)
  user                        User?
  emails                      IdentityEmail[]
  credentials                 Credential[]
  trustedDevices              TrustedDevice[]
  sessions                    Session[]
  emailVerificationTokens     EmailVerificationToken[]
  passwordResetTokens         PasswordResetToken[]
  securityEvents              IdentitySecurityEvent[]
  organizationMemberships     OrganizationMembership[]
  sentOrganizationInvitations OrganizationInvitation[] @relation("OrganizationInvitationInviter")

  @@index([status], map: "idx_identities_status")
  @@index([normalizedLoginEmail], map: "idx_identities_normalized_login_email")
  @@map("identities")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  identityId  String   @unique(map: "uq_users_identity_id") @map("identity_id") @db.Uuid
  displayName String   @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  identity    Identity @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("users")
}

model IdentityEmail {
  id              String    @id @default(uuid()) @db.Uuid
  identityId      String    @map("identity_id") @db.Uuid
  email           String
  normalizedEmail String    @map("normalized_email")
  isPrimary       Boolean   @default(false) @map("is_primary")
  verifiedAt      DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  identity        Identity  @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([identityId], map: "idx_identity_emails_identity_id")
  @@index([normalizedEmail], map: "idx_identity_emails_normalized_email")
  @@map("identity_emails")
}

model Credential {
  id         String           @id @default(uuid()) @db.Uuid
  identityId String           @map("identity_id") @db.Uuid
  type       CredentialType
  secretHash String           @map("secret_hash")
  status     CredentialStatus
  version    Int              @default(1)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt  DateTime?        @map("revoked_at") @db.Timestamptz(6)
  identity   Identity         @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([identityId, type, status], map: "idx_credentials_identity_type_status")
  @@map("credentials")
}

model TrustedDevice {
  id              String              @id @default(uuid()) @db.Uuid
  identityId      String              @map("identity_id") @db.Uuid
  fingerprintHash String              @map("fingerprint_hash")
  displayName     String              @map("display_name")
  status          TrustedDeviceStatus
  firstSeenAt     DateTime            @map("first_seen_at") @db.Timestamptz(6)
  lastActivityAt  DateTime            @map("last_activity_at") @db.Timestamptz(6)
  revokedAt       DateTime?           @map("revoked_at") @db.Timestamptz(6)
  identity        Identity            @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions        Session[]

  @@index([identityId, status], map: "idx_trusted_devices_identity_status")
  @@index([fingerprintHash], map: "idx_trusted_devices_fingerprint_hash")
  @@map("trusted_devices")
}

model Session {
  id             String         @id @default(uuid()) @db.Uuid
  identityId     String         @map("identity_id") @db.Uuid
  deviceId       String?        @map("device_id") @db.Uuid
  status         SessionStatus
  version        Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastActivityAt DateTime       @map("last_activity_at") @db.Timestamptz(6)
  expiresAt      DateTime       @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(6)
  revokedReason  String?        @map("revoked_reason")
  identity       Identity       @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  device         TrustedDevice? @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  refreshTokens  RefreshToken[]

  @@index([identityId, status], map: "idx_sessions_identity_status")
  @@index([deviceId, status], map: "idx_sessions_device_status")
  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@map("sessions")
}

model RefreshToken {
  id         String             @id @default(uuid()) @db.Uuid
  sessionId  String             @map("session_id") @db.Uuid
  familyId   String             @map("family_id") @db.Uuid
  tokenHash  String             @unique(map: "uq_refresh_tokens_token_hash") @map("token_hash")
  status     RefreshTokenStatus
  version    Int                @default(1)
  issuedAt   DateTime           @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt  DateTime           @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?          @map("consumed_at") @db.Timestamptz(6)
  revokedAt  DateTime?          @map("revoked_at") @db.Timestamptz(6)
  session    Session            @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([sessionId, status], map: "idx_refresh_tokens_session_status")
  @@index([familyId, status], map: "idx_refresh_tokens_family_status")
  @@index([expiresAt], map: "idx_refresh_tokens_expires_at")
  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id         String             @id @default(uuid()) @db.Uuid
  identityId String             @map("identity_id") @db.Uuid
  tokenId    String             @unique(map: "uq_email_verification_tokens_token_id") @map("token_id") @db.Uuid
  tokenHash  String             @unique(map: "uq_email_verification_tokens_token_hash") @map("token_hash")
  status     OneTimeTokenStatus
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime           @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?          @map("consumed_at") @db.Timestamptz(6)
  identity   Identity           @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([identityId, status], map: "idx_email_verification_tokens_identity_status")
  @@index([expiresAt], map: "idx_email_verification_tokens_expires_at")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String             @id @default(uuid()) @db.Uuid
  identityId String             @map("identity_id") @db.Uuid
  tokenId    String             @unique(map: "uq_password_reset_tokens_token_id") @map("token_id") @db.Uuid
  tokenHash  String             @unique(map: "uq_password_reset_tokens_token_hash") @map("token_hash")
  status     OneTimeTokenStatus
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt  DateTime           @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime?          @map("consumed_at") @db.Timestamptz(6)
  identity   Identity           @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([identityId, status], map: "idx_password_reset_tokens_identity_status")
  @@index([expiresAt], map: "idx_password_reset_tokens_expires_at")
  @@map("password_reset_tokens")
}

model IdentitySecurityEvent {
  id            String                    @id @default(uuid()) @db.Uuid
  identityId    String?                   @map("identity_id") @db.Uuid
  eventType     IdentitySecurityEventType @map("event_type")
  occurredAt    DateTime                  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  correlationId String                    @map("correlation_id")
  metadata      Json?
  identity      Identity?                 @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([identityId, occurredAt], map: "idx_identity_security_events_identity_occurred_at")
  @@index([eventType, occurredAt], map: "idx_identity_security_events_type_occurred_at")
  @@map("identity_security_events")
}

model Organization {
  id            String                   @id @default(uuid()) @db.Uuid
  publicId      String?                  @unique(map: "uq_organizations_public_id") @map("public_id")
  displayName   String                   @map("display_name")
  slug          String                   @unique(map: "uq_organizations_slug")
  status        OrganizationStatus
  version       Int                      @default(1)
  defaultLocale String                   @map("default_locale")
  timezone      String
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  activatedAt   DateTime?                @map("activated_at") @db.Timestamptz(6)
  suspendedAt   DateTime?                @map("suspended_at") @db.Timestamptz(6)
  closedAt      DateTime?                @map("closed_at") @db.Timestamptz(6)
  archivedAt    DateTime?                @map("archived_at") @db.Timestamptz(6)
  memberships   OrganizationMembership[]
  invitations   OrganizationInvitation[]
  campaigns     Campaign[]
  candidates    Candidate[]

  @@index([status], map: "idx_organizations_status")
  @@index([slug], map: "idx_organizations_slug")
  @@map("organizations")
}

model Campaign {
  id                        String                    @id @default(uuid()) @db.Uuid
  organizationId            String                    @map("organization_id") @db.Uuid
  name                      String
  slug                      String
  description               String?
  status                    CampaignStatus
  visibility                CampaignVisibility
  timezone                  String
  locale                    String
  startsAt                  DateTime                  @map("starts_at") @db.Timestamptz(6)
  endsAt                    DateTime                  @map("ends_at") @db.Timestamptz(6)
  votingMode                CampaignVotingMode        @map("voting_mode")
  votesPerVoter             Int                       @map("votes_per_voter")
  allowMultipleCandidates   Boolean                   @map("allow_multiple_candidates")
  requiresEmailVerification Boolean                   @map("requires_email_verification")
  resultsVisibility         CampaignResultsVisibility @map("results_visibility")
  resultRevealAt            DateTime?                 @map("result_reveal_at") @db.Timestamptz(6)
  createdBy                 String                    @map("created_by") @db.Uuid
  createdAt                 DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt                DateTime?                 @map("archived_at") @db.Timestamptz(6)
  cancelledAt               DateTime?                 @map("cancelled_at") @db.Timestamptz(6)
  version                   Int                       @default(1)
  organization              Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  candidates                Candidate[]

  @@unique([organizationId, slug], map: "uq_campaigns_organization_slug")
  @@index([organizationId], map: "idx_campaigns_organization_id")
  @@index([organizationId, status], map: "idx_campaigns_organization_status")
  @@index([organizationId, visibility], map: "idx_campaigns_organization_visibility")
  @@index([organizationId, createdAt, id], map: "idx_campaigns_organization_created_id")
  @@index([organizationId, startsAt], map: "idx_campaigns_organization_starts_at")
  @@map("campaigns")
}

model Candidate {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  campaignId        String          @map("campaign_id") @db.Uuid
  displayName       String          @map("display_name")
  slug              String
  shortDescription  String?         @map("short_description")
  description       String?
  status            CandidateStatus
  position          Int
  imageAssetId      String?         @map("image_asset_id")
  externalReference String?         @map("external_reference")
  metadata          Json            @default("{}")
  createdBy         String          @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  statusReason      String?         @map("status_reason")
  archivedAt        DateTime?       @map("archived_at") @db.Timestamptz(6)
  version           Int             @default(1)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([campaignId, slug], map: "uq_candidates_campaign_slug")
  @@unique([campaignId, position], map: "uq_candidates_campaign_position")
  @@index([organizationId, campaignId], map: "idx_candidates_organization_campaign")
  @@index([organizationId, campaignId, status], map: "idx_candidates_organization_campaign_status")
  @@index([campaignId, position, createdAt, id], map: "idx_candidates_campaign_position_created_id")
  @@index([organizationId, createdAt], map: "idx_candidates_organization_created_at")
  @@map("candidates")
}

model OrganizationMembership {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  identityId     String                       @map("identity_id") @db.Uuid
  role           OrganizationRole
  status         OrganizationMembershipStatus
  invitationId   String?                      @map("invitation_id") @db.Uuid
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  activatedAt    DateTime                     @map("activated_at") @db.Timestamptz(6)
  suspendedAt    DateTime?                    @map("suspended_at") @db.Timestamptz(6)
  removedAt      DateTime?                    @map("removed_at") @db.Timestamptz(6)
  lastChangedBy  String                       @map("last_changed_by") @db.Uuid
  organization   Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  identity       Identity                     @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invitation     OrganizationInvitation?      @relation(fields: [invitationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizationId, status], map: "idx_org_memberships_organization_status")
  @@index([identityId, status], map: "idx_org_memberships_identity_status")
  @@index([organizationId, role, status], map: "idx_org_memberships_organization_role_status")
  @@map("organization_memberships")
}

model OrganizationInvitation {
  id                       String                       @id @default(uuid()) @db.Uuid
  organizationId           String                       @map("organization_id") @db.Uuid
  normalizedRecipientEmail String                       @map("normalized_recipient_email")
  intendedRole             OrganizationRole             @map("intended_role")
  status                   OrganizationInvitationStatus
  tokenId                  String                       @unique(map: "uq_org_invitations_token_id") @map("token_id") @db.Uuid
  tokenHash                String                       @unique(map: "uq_org_invitations_token_hash") @map("token_hash")
  invitedBy                String                       @map("invited_by") @db.Uuid
  createdAt                DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt                DateTime                     @map("expires_at") @db.Timestamptz(6)
  revokedAt                DateTime?                    @map("revoked_at") @db.Timestamptz(6)
  acceptedAt               DateTime?                    @map("accepted_at") @db.Timestamptz(6)
  organization             Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  invitedByIdentity        Identity                     @relation("OrganizationInvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  memberships              OrganizationMembership[]

  @@index([organizationId, status], map: "idx_org_invitations_organization_status")
  @@index([normalizedRecipientEmail, status], map: "idx_org_invitations_email_status")
  @@index([expiresAt], map: "idx_org_invitations_expires_at")
  @@map("organization_invitations")
}

model AuditRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String?  @map("tenant_id") @db.Uuid
  streamType         String   @map("stream_type")
  streamId           String   @map("stream_id")
  sequenceNumber     Int      @map("sequence_number")
  eventName          String   @map("event_name")
  eventVersion       Int      @map("event_version")
  occurredAt         DateTime @map("occurred_at") @db.Timestamptz(6)
  actorType          String   @map("actor_type")
  actorIdentityId    String?  @map("actor_identity_id") @db.Uuid
  actorMembershipId  String?  @map("actor_membership_id") @db.Uuid
  executionMode      String   @map("execution_mode")
  executionSource    String   @map("execution_source")
  resourceType       String   @map("resource_type")
  resourceId         String?  @map("resource_id")
  action             String
  outcome            String
  reasonCode         String?  @map("reason_code")
  correlationId      String   @map("correlation_id")
  requestId          String?  @map("request_id")
  jobId              String?  @map("job_id")
  privileged         Boolean  @default(false)
  privilegedReason   String?  @map("privileged_reason")
  retentionCategory  String   @map("retention_category")
  metadataJson       Json     @map("metadata_json")
  previousRecordHash String?  @map("previous_record_hash")
  recordHash         String   @map("record_hash")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([streamType, streamId, sequenceNumber], map: "uq_audit_records_stream_sequence")
  @@unique([recordHash], map: "uq_audit_records_record_hash")
  @@index([tenantId, occurredAt], map: "idx_audit_records_tenant_occurred_at")
  @@index([eventName, occurredAt], map: "idx_audit_records_event_occurred_at")
  @@index([actorIdentityId, occurredAt], map: "idx_audit_records_actor_occurred_at")
  @@index([resourceType, resourceId, occurredAt], map: "idx_audit_records_resource_occurred_at")
  @@index([correlationId], map: "idx_audit_records_correlation_id")
  @@map("audit_records")
}
