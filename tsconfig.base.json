{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@seneve/config": ["packages/config/src/index.ts"],
      "@seneve/shared": ["packages/shared/src/index.ts"],
      "@seneve/contracts": ["packages/contracts/src/index.ts"],
      "@seneve/testing": ["packages/testing/src/index.ts"]
    }
  }
}

